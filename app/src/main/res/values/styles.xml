<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextoMarca">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoTitulo">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textAppearance">?attr/textAppearanceHeadlineMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoCuerpo">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextoAviso">
        <item name="android:padding">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Agenda.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/violeta</item>
        <item name="android:textColor">@color/sobre_violeta</item>
        <item name="iconTint">@color/sobre_violeta</item>
    </style>

    <style name="Widget.Agenda.Button.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="android:textColor">@color/violeta_oscuro</item>
        <item name="backgroundTint">@color/blanco_tarjeta</item>
        <item name="iconTint">@color/violeta</item>
    </style>

    <style name="Widget.Agenda.Button.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/violeta</item>
        <item name="rippleColor">@color/lavanda</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Widget.Agenda.Button.Editar" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="android:textColor">@color/violeta_oscuro</item>
        <item name="backgroundTint">@color/lavanda</item>
    </style>

    <style name="Widget.Agenda.Button.Peligro" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/error</item>
        <item name="android:textColor">@color/error</item>
        <item name="backgroundTint">@color/error_suave</item>
    </style>

    <style name="Widget.Agenda.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/campo_borde</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/blanco_tarjeta</item>
        <item name="hintTextColor">@color/violeta</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="startIconTint">@color/violeta</item>
        <item name="endIconTint">@color/texto_secundario</item>
    </style>

    <style name="Widget.Agenda.Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/blanco_tarjeta</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
