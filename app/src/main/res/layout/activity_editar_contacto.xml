<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pantallaEditarContacto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Editar contacto"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Los cambios se guardan en el contacto existente."
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <EditText
            android:id="@+id/editTextNombreEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Nombre"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/editTextApellidoEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Apellido"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/editTextTelefonoEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Teléfono"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/editTextEmailEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Correo"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:minHeight="56dp" />

        <TextView
            android:id="@+id/textResultadoEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonGuardarEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="Guardar cambios" />

        <Button
            android:id="@+id/buttonVolverEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="← Volver a contactos" />
    </LinearLayout>
</ScrollView>
