<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pantallaRegistro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Crear cuenta"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="La cuenta se guarda en la base de datos."
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <EditText
            android:id="@+id/editTextCedulaRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Cédula de 10 dígitos"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="10"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/editTextNombreRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nombre"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/editTextApellidoRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Apellido"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/editTextCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Correo electrónico"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/editTextClaveRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Contraseña"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:minHeight="56dp" />

        <EditText
            android:id="@+id/editTextConfirmarRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Confirmar contraseña"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:minHeight="56dp" />

        <TextView
            android:id="@+id/textResultadoRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="Registrar" />

        <Button
            android:id="@+id/buttonVolverRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="← Volver al inicio" />
    </LinearLayout>
</ScrollView>
