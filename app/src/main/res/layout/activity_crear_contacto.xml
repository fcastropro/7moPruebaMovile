<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pantallaCrearContacto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Crear contacto"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="El contacto se guarda en la base de datos."
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageVistaPrevia"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:contentDescription="Vista previa de la fotografía"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar"
            app:shapeAppearanceOverlay="@style/FormaCircular" />

        <Button
            android:id="@+id/buttonSeleccionarFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="Seleccionar fotografía" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nombre"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextNombreContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:minHeight="56dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Apellido"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextApellidoContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Apellido"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:minHeight="56dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Teléfono"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextTelefonoContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:minHeight="56dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Correo"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextEmailContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="correo@ejemplo.com"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:minHeight="56dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/textResultadoCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonGuardarContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="Guardar en la base" />

        <Button
            android:id="@+id/buttonVolverCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:text="← Volver a contactos" />
    </LinearLayout>
</ScrollView>
